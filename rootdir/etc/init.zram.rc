# zRAM Memory Expansion Configuration Script
# Configures 2GB of zRAM by default for improved performance on low-memory devices

on init
    # Set up zRAM device with 2GB (2147483648 bytes)
    # This creates virtual compressed memory space
    write /sys/block/zram0/disksize 2147483648
    
on late-init
    # Initialize swap
    mkswap /dev/block/zram0
    swapon /dev/block/zram0 0x4000
    
    # Set zRAM write-back parameters
    # Mark idle delay: 60 minutes
    write /sys/block/zram0/idle 60
    
    # Enable writeback for idle memory
    write /sys/block/zram0/writeback 1
    
    # Set compression algorithm (if available)
    write /sys/block/zram0/comp_algorithm lz4
